# The build id of the game recorder (src/gameplay/replay/runtime.cpp): a playback must run the build that made the
# recording. Run by the thandor_build_id target on every build (cmake -P); it rewrites OUTPUT only when the text
# changes, so an unchanged commit and work tree recompile nothing.
#   VERSION  the project version            SOURCE_DIR  the source tree (a git work tree, or not)
#   CONFIG   compiler, build type, options  OUTPUT      the generated .cpp
# The id is "<version> <commit>" for a clean tree and "<version> <commit>-dirty-<hash>" with uncommitted changes in
# the sources (src, include, cmake, CMakeLists.txt; the hash is a SHA-1 of their diff against HEAD, so two builds of
# the same edits agree). Without git: "<version> unknown".
set(commit "unknown")
set(dirty "")
find_program(GIT_EXECUTABLE git)
if(GIT_EXECUTABLE)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=12 HEAD
                    OUTPUT_VARIABLE head RESULT_VARIABLE headResult OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(headResult EQUAL 0 AND NOT head STREQUAL "")
        set(commit "${head}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" -c core.quotepath=off diff HEAD --no-ext-diff
                                --no-textconv --binary -- src include cmake CMakeLists.txt
                        OUTPUT_VARIABLE diff RESULT_VARIABLE diffResult ERROR_QUIET)
        if(diffResult EQUAL 0 AND NOT diff STREQUAL "")
            string(SHA1 diffHash "${diff}")
            string(SUBSTRING "${diffHash}" 0 12 diffHash)
            set(dirty "-dirty-${diffHash}")
        endif()
    endif()
endif()
set(text "/* Generated by cmake/build_id.cmake - do not edit. */\n")
string(APPEND text "extern const char g_ThandorBuildId[];\nextern const char g_ThandorBuildConfig[];\n")
string(APPEND text "const char g_ThandorBuildId[] = \"${VERSION} ${commit}${dirty}\";\n")
string(APPEND text "const char g_ThandorBuildConfig[] = \"${CONFIG}\";\n")
set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUTPUT}" "${text}")
endif()
