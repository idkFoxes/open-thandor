# thandor.dat with leftovers in the reserved dwords 0x50..0x58 (the original never reads them; this version keeps
# pathing, objective_overlay and autosave there): the migration must not take them over
include: old_dat_clean.expect
pending A: game.pathing = <default>
pending A: game.objective_overlay = <default>
pending A: game.autosave = <default>
pending A: absent: dword_5
pending A: absent: 0xDEADBEEF
