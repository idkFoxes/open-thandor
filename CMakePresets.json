{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-x86",
      "hidden": true,
      "description": "MSVC 32-bit x86, found without vcvars (cmake/msvc-x86.cmake)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-msvc-${presetName}",
      "toolchainFile": "${sourceDir}/cmake/msvc-x86.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "debug",
      "displayName": "MSVC x86 Debug",
      "inherits": "msvc-x86",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "MSVC x86 RelWithDebInfo (test build)",
      "inherits": "msvc-x86",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "test",
      "displayName": "MSVC x86 RelWithDebInfo with test aids (windowed, local multiplayer)",
      "inherits": "msvc-x86",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "THANDOR_TEST_AIDS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "test", "configurePreset": "test" }
  ]
}
