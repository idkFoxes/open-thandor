#ifndef THANDOR_VERSION_H
#define THANDOR_VERSION_H

/* The version of Open Thandor. Generated by CMake (configure_file) into the build directory as
   generated/thandor/version.h from the single version source, project(open_thandor VERSION ...) in
   CMakeLists.txt; it also feeds the VERSIONINFO resource (src/platform/bootstrap/thandor.rc.in). */

#define THANDOR_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define THANDOR_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define THANDOR_VERSION_PATCH @PROJECT_VERSION_PATCH@
/* "1.0.7": the log, the main menu and the multiplayer session title */
#define THANDOR_VERSION_STRING "@PROJECT_VERSION@"
/* "Open Thandor 1.0.7" */
#define THANDOR_PRODUCT_VERSION_STRING "Open Thandor @PROJECT_VERSION@"

#endif
