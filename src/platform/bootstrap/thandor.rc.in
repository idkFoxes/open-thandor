/*
 * Open Thandor
 * Project: https://github.com/idkFoxes/open-thandor/tree/main
 * File: https://github.com/idkFoxes/open-thandor/blob/main/src/platform/bootstrap/thandor.rc.in
 * Project code (not in the original game)
 */

/* The resources of thandor.exe: the game's icon (thandor.ico, the icon of the original exe) and the version
   resource. Generated by CMake (configure_file) into the build directory as generated/thandor.rc, with the version
   of project(open_thandor VERSION ...) in CMakeLists.txt. Compiled by windres (MinGW) or rc.exe (MSVC); the
   numeric constants stand for those of winver.h (VS_FFI_FILEFLAGSMASK 0x3F, VOS_NT_WINDOWS32 0x40004,
   VFT_APP 1), so no Windows SDK header is needed. */

1 ICON "@THANDOR_RC_ICON@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3FL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Open Thandor"
            VALUE "FileDescription", "Thandor (Open Thandor @PROJECT_VERSION@)"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "thandor"
            VALUE "LegalCopyright", "Thandor (c) 1999 Innonics GmbH. Open Thandor: open-source reimplementation"
            VALUE "OriginalFilename", "thandor.exe"
            VALUE "ProductName", "Thandor"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
